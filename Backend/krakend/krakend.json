{
  "$schema": "https://www.krakend.io/schema/krakend.json",
  "version": 3,
  "name": "nexo-gateway",
  "port": 8080,
  "timeout": "3000ms",
  "cache_ttl": "0s",
  "output_encoding": "json",
  "extra_config": {
    "telemetry/logging": {
      "level": "DEBUG",
      "prefix": "[NEXO-GATEWAY]",
      "syslog": false,
      "stdout": true
    },
    "security/cors": {
      "allow_origins": ["http://localhost:8080", "http://localhost:5173"],
      "allow_methods": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE"],
      "allow_headers": ["Origin", "Authorization", "Content-Type"],
      "expose_headers": ["Content-Length"],
      "max_age": "12h"
    }
  },
  "endpoints": [
    {
      "endpoint": "/api/auth/register",
      "method": "POST",
      "backend": [{ "url_pattern": "/register", "host": ["http://auth-service:3001"] }]
    },
    {
      "endpoint": "/api/auth/login",
      "method": "POST",
      "backend": [{ "url_pattern": "/login", "host": ["http://auth-service:3001"] }]
    },
    {
      "endpoint": "/api/auth/me",
      "method": "GET",
      "input_headers": ["Authorization"],
      "backend": [{ "url_pattern": "/me", "host": ["http://auth-service:3001"] }]
    },
    {
      "endpoint": "/api/auth/me",
      "method": "PUT",
      "input_headers": ["Authorization", "Content-Type"],
      "backend": [{ "url_pattern": "/me", "host": ["http://auth-service:3001"] }]
    },
    {
      "endpoint": "/api/auth/profile/candidate",
      "method": "GET",
      "input_headers": ["Authorization"],
      "backend": [{ "url_pattern": "/profile/candidate", "host": ["http://auth-service:3001"] }]
    },
    {
      "endpoint": "/api/auth/profile/candidate",
      "method": "PUT",
      "input_headers": ["Authorization", "Content-Type"],
      "backend": [{ "url_pattern": "/profile/candidate", "host": ["http://auth-service:3001"] }]
    },
    {
      "endpoint": "/api/auth/profile/company",
      "method": "GET",
      "input_headers": ["Authorization"],
      "backend": [{ "url_pattern": "/profile/company", "host": ["http://auth-service:3001"] }]
    },
    {
      "endpoint": "/api/auth/profile/company",
      "method": "PUT",
      "input_headers": ["Authorization", "Content-Type"],
      "backend": [{ "url_pattern": "/profile/company", "host": ["http://auth-service:3001"] }]
    },
    {
      "endpoint": "/api/jobs",
      "method": "GET",
      "backend": [{ "url_pattern": "/jobs", "host": ["http://jobs-service:3002"] }]
    },
    {
      "endpoint": "/api/jobs",
      "method": "POST",
      "input_headers": ["Authorization", "Content-Type"],
      "backend": [{ "url_pattern": "/jobs", "host": ["http://jobs-service:3002"] }]
    },
    {
      "endpoint": "/api/jobs/{jobId}",
      "method": "GET",
      "backend": [{ "url_pattern": "/jobs/{jobId}", "host": ["http://jobs-service:3002"] }]
    },
    {
      "endpoint": "/api/jobs/{jobId}",
      "method": "PUT",
      "input_headers": ["Authorization", "Content-Type"],
      "backend": [{ "url_pattern": "/jobs/{jobId}", "host": ["http://jobs-service:3002"] }]
    },
    {
      "endpoint": "/api/jobs/{jobId}",
      "method": "DELETE",
      "input_headers": ["Authorization"],
      "backend": [{ "url_pattern": "/jobs/{jobId}", "host": ["http://jobs-service:3002"] }]
    },
    {
      "endpoint": "/api/applications",
      "method": "GET",
      "backend": [{ "url_pattern": "/applications", "host": ["http://applications-service:3003"] }]
    },
    {
      "endpoint": "/api/applications",
      "method": "POST",
      "backend": [{ "url_pattern": "/applications", "host": ["http://applications-service:3003"] }]
    },
    {
      "endpoint": "/api/applications/{applicationId}",
      "method": "GET",
      "backend": [{ "url_pattern": "/applications/{applicationId}", "host": ["http://applications-service:3003"] }]
    },
    {
      "endpoint": "/api/applications/{applicationId}",
      "method": "PUT",
      "backend": [{ "url_pattern": "/applications/{applicationId}", "host": ["http://applications-service:3003"] }]
    }
  ]
}
